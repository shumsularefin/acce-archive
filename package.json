{
  "name": "acce-archive",
  "private": true,
  "description": "ACCE Archive - static site on Firebase Hosting with a Google Drive backend. Dependencies here are for tests and deployment only; the site itself has no build step.",
  "type": "module",
  "scripts": {
    "serve": "node tests/serve.mjs",
    "test": "npm run test:unit && npm run test:rules && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-acce \"node --test tests/rules/*.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-acce \"playwright test\"",
    "deploy:rules": "firebase deploy --only firestore --project accearchive"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "1.56.1",
    "firebase": "10.14.1",
    "firebase-tools": "^13.29.0"
  }
}
