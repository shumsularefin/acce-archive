rules_version = '2';

// ACCE Archive security rules.
// Anything that moves files or changes a submission's status goes through the
// Apps Script backend (which runs as the project owner and bypasses these rules),
// so clients only ever write their own profile and reports; staff additionally curate
// the catalogue (items, courses) and owners manage the team.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function adminDoc() { return /databases/$(database)/documents/admins/$(myEmail()); }

    // Permanent owners: always owners, cannot be demoted or removed from the dashboard.
    // Keep in step with CONFIG.rootOwners (public/js/config.js) and ROOT_OWNERS (apps-script/Code.js).
    function rootOwners() { return ['muhammadshamsularefin01@gmail.com']; }
    function isRootOwner() { return verified() && myEmail() in rootOwners(); }
    function hasRole(roles) { return verified() && exists(adminDoc()) && get(adminDoc()).data.role in roles; }
    function isStaff() { return isRootOwner() || hasRole(['reviewer', 'admin', 'owner']); }
    function isAdmin() { return isRootOwner() || hasRole(['admin', 'owner']); }
    function isOwner() { return isRootOwner() || hasRole(['owner']); }

    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || str(d[k], 0, max); }

    // ---------- people ----------
    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'email', 'photoURL', 'affiliation', 'session', 'studentId',
                               'createdAt', 'lastSeen', 'visits', 'status'])
        && str(d.displayName, 2, 80)
        && d.email == request.auth.token.email
        && optStr(d, 'photoURL', 600)
        && d.affiliation in ['student', 'alumni', 'faculty', 'staff', 'guest']
        && (!('session' in d) || d.session == '' || (d.session is string && d.session.matches('^[0-9]{4}$')))
        && (!('studentId' in d) || d.studentId == '' || (d.studentId is string && d.studentId.matches('^[0-9]{2}ACE0[0-9]{2}$')))
        && (d.affiliation != 'student' || (d.studentId is string && d.studentId.size() == 8))
        && (!('visits' in d) || d.visits is int)
        && (!('lastSeen' in d) || d.lastSeen is timestamp)
        && d.createdAt is timestamp;
    }

    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isStaff();
      allow list: if isStaff();
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data) && !('status' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.get('status', null) == resource.data.get('status', null)
        && request.resource.data.createdAt == resource.data.createdAt;
      // staff may only block / unblock contributors
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['active', 'blocked'];
    }

    // Student visitor log: one document per student ID, written by the entry form (no account needed).
    match /visitors/{sid} {
      allow read: if isStaff();
      allow create, update: if sid.matches('^[0-9]{2}ACE0[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name', 'session', 'studentId', 'firstSeen', 'lastSeen', 'visits', 'device'])
        && request.resource.data.studentId == sid
        && str(request.resource.data.name, 3, 80)
        && request.resource.data.session is string && request.resource.data.session.matches('^[0-9]{4}$')
        && request.resource.data.lastSeen == request.time
        && request.resource.data.visits is int
        && optStr(request.resource.data, 'device', 200);
      allow delete: if isAdmin();
    }

    match /admins/{email} {
      allow get: if verified() && myEmail() == email;
      allow read: if isStaff();
      // owners manage the team; nobody can change their own role or touch a permanent owner
      allow create, update: if isOwner() && email != myEmail() && !(email in rootOwners())
        && email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$')
        && request.resource.data.keys().hasOnly(['email', 'role', 'addedBy', 'addedAt', 'notify'])
        && request.resource.data.email == email
        && request.resource.data.role in ['reviewer', 'admin', 'owner'];
      allow delete: if isOwner() && email != myEmail() && !(email in rootOwners());
    }

    // ---------- workflow ----------
    match /submissions/{id} {
      allow get, list: if (signedIn() && resource.data.uid == request.auth.uid) || isStaff();
      allow write: if false;
    }

    match /reports/{id} {
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'fileId', 'fileName', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && str(request.resource.data.fileId, 1, 120)
        && str(request.resource.data.fileName, 0, 300)
        && request.resource.data.reason in ['broken', 'wrong', 'duplicate', 'copyright', 'privacy', 'other']
        && str(request.resource.data.details, 0, 1500)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow get, list: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'resolvedBy', 'resolvedAt'])
        && request.resource.data.status in ['open', 'resolved', 'dismissed'];
    }

    // ---------- public catalogue ----------
    // The catalogue is the archive's source of truth: one record per work, pointing at
    // wherever its bytes live (storage.provider = drive | r2 | url).
    function validItem(d) {
      return d.keys().hasOnly(['title', 'kind', 'collection', 'type', 'courseCode', 'courseTitle', 'level', 'session',
                               'examKind', 'examYear', 'instructors', 'authors', 'curriculum', 'curricula', 'language',
                               'description', 'tags', 'rights', 'credit', 'file', 'storage', 'status', 'contributor',
                               'submissionId', 'source', 'legacyPath', 'folderId', 'folderPath', 'curated', 'approvedAt',
                               'updatedAt', 'updatedBy', 'withdrawnReason', 'withdrawnAt'])
        && d.kind in ['file', 'link']
        && str(d.title, 1, 300)
        && d.collection in ['bsc', 'msc', 'qbank', 'misc']
        && d.status in ['published', 'withdrawn', 'missing']
        && d.storage is map && d.storage.provider in ['drive', 'r2', 'url']
        && (!('curricula' in d) || (d.curricula is list && d.curricula.size() <= 8))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 20))
        && d.updatedAt == request.time;
    }

    match /items/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validItem(request.resource.data);
      allow delete: if isOwner();
    }

    match /courses/{code} {
      allow read: if true;
      allow create, update: if isAdmin() && code.matches('^[A-Z]{2,6}-[0-9]{3,4}[A-Z]?$')
        && request.resource.data.keys().hasOnly(['code', 'title', 'program', 'level', 'credits', 'curricula',
                                                 'instructors', 'active', 'destinations', 'updatedAt', 'updatedBy'])
        && optStr(request.resource.data, 'title', 160);
      allow delete: if isAdmin();
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isOwner();
      // admins switch catalogue browsing on/off (set by Import / sync)
      allow write: if doc == 'catalog' && isAdmin()
        && request.resource.data.keys().hasOnly(['live', 'lastImport', 'snapshot', 'updatedAt', 'updatedBy'])
        && (!('live' in request.resource.data) || request.resource.data.live is bool);
    }

    // Published catalogue snapshot: every published record packed into a few documents,
    // so a visitor reads ~2 documents instead of one per record (Spark plan: 50k reads/day).
    match /catalogue/{chunk} {
      allow read: if true;
      allow write: if isAdmin() && chunk.matches('^[0-9]{1,3}$');
    }

    // ---------- internal ----------
    match /fingerprints/{sha} { allow read: if isStaff(); allow write: if false; }
    match /audit/{id}        { allow read: if isStaff(); allow write: if false; }
  }
}
